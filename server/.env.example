# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
# Database name (defaults to VALCO)
MONGODB_DB=VALCO
# At least 32 random characters
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
ADMIN_EMAIL=admin@valco.local
ADMIN_PASSWORD=change-me-to-a-strong-password
# Comma-separated list of allowed frontend URLs
CLIENT_ORIGIN=http://localhost:5173,https://your-site.vercel.app
PORT=5000
# Image uploads (required in production: the host's disk is wiped on restart).
# Paste the "API environment variable" from the Cloudinary dashboard:
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# Optional folder name inside Cloudinary
CLOUDINARY_FOLDER=valco
